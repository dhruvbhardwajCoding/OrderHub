<mvc:View
    controllerName="orderhub.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page title="{orderNo}" showNavButton="true" navButtonPress=".onNavBack" class="ohPage">
        <ObjectHeader
            title="{orderNo}"
            number="{grossAmount}"
            numberUnit="{currency_code}"
            responsive="true"
            class="ohCardHeader">
            <attributes>
                <ObjectAttribute title="{i18n>customer}" text="{customerName}" />
                <ObjectAttribute title="{i18n>createdAt}" text="{path: 'createdAt', formatOptions: {style: 'medium'}}" />
            </attributes>
            <statuses>
                <ObjectStatus text="{status}" state="{
                    path: 'status',
                    formatter: '.formatter.statusState'
                }" />
            </statuses>
        </ObjectHeader>

        <Panel headerText="{i18n>orderDetails}" class="ohCard">
            <f:SimpleForm
                layout="ResponsiveGridLayout"
                columnsL="2" columnsM="2"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanL="0" emptySpanM="0">
                <f:content>
                    <Label text="{i18n>orderNo}" />
                    <Text text="{orderNo}" />
                    <Label text="{i18n>customerID}" />
                    <Text text="{customerID}" />
                    <Label text="{i18n>customerName}" />
                    <Text text="{customerName}" />
                    <Label text="{i18n>status}" />
                    <Text text="{status}" />
                    <Label text="{i18n>createdAt}" />
                    <Text text="{path: 'createdAt', formatOptions: {style: 'medium'}}" />
                    <Label text="{i18n>netAmount}" />
                    <ObjectNumber number="{netAmount}" unit="{currency_code}" emphasized="false" />
                    <Label text="{i18n>taxAmount}" />
                    <ObjectNumber number="{taxAmount}" unit="{currency_code}" emphasized="false" />
                    <Label text="{i18n>grossAmount}" />
                    <ObjectNumber number="{grossAmount}" unit="{currency_code}" />
                </f:content>
            </f:SimpleForm>
        </Panel>

        <Panel headerText="{i18n>orderItems}" class="ohCard">
            <Table items="{items}">
                <columns>
                    <Column>
                        <Text text="{i18n>product}" />
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>unitPrice}" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>quantity}" />
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>discount}" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>netAmount}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{productName}" />
                            <ObjectNumber number="{unitPrice}" />
                            <Text text="{quantity}" />
                            <Text text="{discount}%" />
                            <ObjectNumber number="{netAmount}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <Panel headerText="{i18n>invoiceDetails}" id="invoicePanel" visible="false" class="ohCard">
            <f:SimpleForm
                layout="ResponsiveGridLayout"
                columnsL="2" columnsM="2"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanL="0" emptySpanM="0">
                <f:content>
                    <Label text="{i18n>invoiceNo}" />
                    <Text text="{invoice/invoiceNo}" />
                    <Label text="{i18n>mailStatus}" />
                    <ObjectStatus text="{invoice/mailStatus}" state="{
                        path: 'invoice/mailStatus',
                        formatter: '.formatter.mailStatusState'
                    }" />
                    <Label text="{i18n>sentAt}" />
                    <Text text="{path: 'invoice/sentAt', formatOptions: {style: 'medium'}}" />
                    <Label text="{i18n>sentTo}" />
                    <Text text="{invoice/sentTo}" />
                </f:content>
            </f:SimpleForm>
        </Panel>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button id="btnContinueDraft" text="{i18n>continueDraft}" type="Emphasized" visible="false" press=".onContinueDraft" />
                <Button id="btnEdit" text="{i18n>editOrder}" type="Default" visible="false" press=".onEdit" />
                <Button id="btnDelete" text="{i18n>deleteOrder}" type="Reject" visible="false" press=".onDelete" />
                <Button id="btnSubmit" text="{i18n>submit}" type="Emphasized" visible="false" press=".onSubmit" />
                <Button id="btnApprove" text="{i18n>approve}" type="Accept" visible="false" press=".onApprove" />
                <Button id="btnCancel" text="{i18n>cancel}" type="Reject" visible="false" press=".onCancel" />
                <Button id="btnCreateInvoice" text="{i18n>createInvoice}" type="Accept" visible="false" press=".onCreateInvoice" />
                <Button id="btnViewInvoice" text="{i18n>viewInvoice}" type="Default" visible="false" press=".onViewInvoice" />
                <Button id="btnSendInvoice" text="{i18n>sendInvoice}" type="Emphasized" visible="false" press=".onSendInvoice" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
