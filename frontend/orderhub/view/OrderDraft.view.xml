<mvc:View
    controllerName="orderhub.controller.OrderDraft"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="{i18n>orderDraftTitle}" showNavButton="true" navButtonPress=".onNavBack" class="ohPage" busy="{draftUi>/busy}">
        <ObjectHeader
            id="customerHeader"
            title="{customerName}"
            number="{grossAmount}"
            numberUnit="{currency_code}"
            responsive="true"
            class="ohCardHeader">
            <statuses>
                <ObjectStatus text="{i18n>draftStatus}" state="Warning" icon="sap-icon://edit" />
            </statuses>
        </ObjectHeader>

        <Panel id="orderItemsPanel" class="ohCard">
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="{i18n>orderItems}" />
                    <ToolbarSpacer />
                    <Button icon="sap-icon://add" text="{i18n>addProduct}" type="Emphasized" press=".onAddProduct" />
                </OverflowToolbar>
            </headerToolbar>
            <Table id="itemsTable" items="{items}">
                <noData>
                    <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Spot" title="{i18n>noProductsSelected}" description=" " />
                </noData>
                <columns>
                    <Column>
                        <Text text="{i18n>product}" />
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>unitPrice}" />
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>quantity}" />
                    </Column>
                    <Column width="7rem" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>discount}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>stockColumn}" />
                    </Column>
                    <Column width="3.5rem" hAlign="End">
                        <Text text="" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{productName}" />
                            <ObjectNumber number="{unitPrice}" unit="USD" />
                            <Input value="{quantity}" type="Number" placeholder="Qty" change=".onItemChange" />
                            <Input value="{discount}" type="Number" placeholder="%" change=".onItemChange" />
                            <ObjectStatus
                                visible="{parts: [{path: 'quantity', targetType: 'any'}, {path: 'productID', targetType: 'any'}, {path: 'draftUi>/stock', targetType: 'any'}], formatter: '.formatter.stockWarningVisibleByLookup'}"
                                icon="sap-icon://alert"
                                state="Warning"
                                text="{i18n>stockWarningShort}" />
                            <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>removeProduct}" press=".onRemoveProduct" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="{i18n>discardDraft}" type="Reject" press=".onDiscard" />
                <Button text="{i18n>saveDraftActivate}" press=".onSave" />
                <Button text="{i18n>saveAndSubmit}" type="Emphasized" press=".onSaveAndSubmit" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
