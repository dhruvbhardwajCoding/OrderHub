<mvc:View
    controllerName="orderhub.controller.CustomerDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page title="{CompanyName}" showNavButton="true" navButtonPress=".onNavBack" class="ohPage">
        <content>
            <ObjectHeader
                title="{CompanyName}"
                responsive="true"
                class="ohCardHeader">
                <attributes>
                    <ObjectAttribute title="{i18n>contactName}" text="{ContactName}" />
                    <ObjectAttribute title="{i18n>contactTitle}" text="{ContactTitle}" />
                    <ObjectAttribute title="{i18n>city}" text="{City}" />
                    <ObjectAttribute title="{i18n>country}" text="{Country}" />
                </attributes>
            </ObjectHeader>
            <Panel headerText="{i18n>customerInfoSection}" class="ohCard">
                <f:SimpleForm
                    editable="false"
                    layout="ResponsiveGridLayout"
                    columnsL="2" columnsM="2"
                    labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                    emptySpanL="0" emptySpanM="0">
                    <f:content>
                        <Label text="{i18n>companyName}" />
                        <Text text="{CompanyName}" />
                        <Label text="{i18n>contactName}" />
                        <Text text="{ContactName}" />
                        <Label text="{i18n>contactTitle}" />
                        <Text text="{ContactTitle}" />
                        <Label text="{i18n>phone}" />
                        <Text text="{Phone}" />
                        <Label text="{i18n>fax}" />
                        <Text text="{Fax}" />
                        <Label text="{i18n>address}" />
                        <Text text="{Address}" />
                        <Label text="{i18n>city}" />
                        <Text text="{City}" />
                        <Label text="{i18n>region}" />
                        <Text text="{Region}" />
                        <Label text="{i18n>postalCode}" />
                        <Text text="{PostalCode}" />
                        <Label text="{i18n>country}" />
                        <Text text="{Country}" />
                    </f:content>
                </f:SimpleForm>
            </Panel>
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="{i18n>createOrder}" type="Emphasized" visible="{= ${user>/roles/SalesRep} === true}" press=".onCreateOrder" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
