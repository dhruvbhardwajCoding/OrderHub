<mvc:View
    controllerName="orderhub.controller.CreateOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="{i18n>createOrderTitle}" showNavButton="true" navButtonPress=".onNavBack" class="ohPage">
        <ObjectHeader
            id="customerHeader"
            title="{orderModel>/customerName}"
            responsive="true"
            class="ohCardHeader">
            <attributes>
                <ObjectAttribute title="{i18n>city}" text="{orderModel>/city}" />
                <ObjectAttribute title="{i18n>country}" text="{orderModel>/country}" />
            </attributes>
        </ObjectHeader>

        <Panel id="orderItemsPanel" class="ohCard">
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="{i18n>orderItems}" />
                    <ToolbarSpacer />
                    <Button icon="sap-icon://add" text="{i18n>addProduct}" type="Emphasized" press=".onAddProduct" />
                </OverflowToolbar>
            </headerToolbar>
            <Table id="itemsTable" items="{orderModel>/items}">
                <noData>
                    <IllustratedMessage illustrationType="sapIllus-NoData" illustrationSize="Spot" title="{i18n>noProductsSelected}" description=" " />
                </noData>
                <columns>
                    <Column>
                        <Text text="{i18n>product}" />
                    </Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>unitPrice}" />
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>quantity}" />
                    </Column>
                    <Column width="7rem" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>discount}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>stockColumn}" />
                    </Column>
                    <Column width="3.5rem" hAlign="End">
                        <Text text="" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{orderModel>productName}" />
                            <ObjectNumber number="{orderModel>unitPrice}" unit="USD" />
                            <Input value="{orderModel>quantity}" type="Number" placeholder="Qty" />
                            <Input value="{orderModel>discount}" type="Number" placeholder="%" />
                            <ObjectStatus
                                visible="{parts: ['orderModel>quantity', 'orderModel>unitsInStock'], formatter: '.formatter.stockWarningVisible'}"
                                icon="sap-icon://alert"
                                state="Warning"
                                text="{i18n>stockWarningShort}" />
                            <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>removeProduct}" press=".onRemoveProduct" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="{i18n>saveOrder}" press=".onSaveOrder" />
                <Button text="{i18n>submitOrder}" type="Emphasized" press=".onSubmitOrder" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
