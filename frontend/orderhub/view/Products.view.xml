<mvc:View
    controllerName="orderhub.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>productsTitle}" showNavButton="false" class="ohPage">
        <subHeader>
            <Toolbar>
                <SearchField id="productsSearch" placeholder="{i18n>searchProducts}" search=".onSearch" />
            </Toolbar>
        </subHeader>
        <content>
            <Panel class="ohCard">
                <Table id="productsTable"
                    growing="true"
                    growingThreshold="25"
                    growingScrollToLoad="true"
                    items="{
                        path: '/Products',
                        sorter: {
                            path: 'ProductName'
                        }
                    }">
                    <noData>
                        <IllustratedMessage />
                    </noData>
                    <columns>
                        <Column>
                            <Text text="{i18n>productName}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>unitPrice}" />
                        </Column>
                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>unitsInStock}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>discontinued}" />
                        </Column>
                        <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                            <Text text="{i18n>categoryId}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{ProductName}" />
                                <ObjectNumber number="{UnitPrice}" unit="USD" />
                                <Text text="{UnitsInStock}" />
                                <ObjectStatus text="{
                                    path: 'Discontinued',
                                    targetType: 'any',
                                    formatter: '.formatter.discontinuedText'
                                }" state="{
                                    path: 'Discontinued',
                                    targetType: 'any',
                                    formatter: '.formatter.discontinuedState'
                                }" />
                                <Text text="{CategoryID}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
