<mvc:View
    controllerName="orderhub.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">
    <Page title="{i18n>dashboardTitle}" showNavButton="false" class="ohPage">
        <content>
            <Panel headerText="{i18n>overviewHeader}" busy="{dashboard>/busy}" class="ohCard">
                <HBox renderType="Bare" class="ohKpis">
                    <GenericTile header="{i18n>totalOrdersHeader}" press="onOrderPress">
                        <TileContent>
                            <NumericContent value="{dashboard>/orderCount}" withMargin="false" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="{i18n>totalRevenueHeader}">
                        <TileContent unit="USD">
                            <NumericContent
                                value="{path: 'dashboard>/revenue', formatter: '.formatter.compactValue'}"
                                scale="{path: 'dashboard>/revenue', formatter: '.formatter.compactScale'}"
                                withMargin="false" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="{i18n>pendingApprovalsHeader}">
                        <TileContent>
                            <NumericContent value="{dashboard>/openApprovals}" valueColor="Critical" withMargin="false" />
                        </TileContent>
                    </GenericTile>
                    <GenericTile header="{i18n>invoicesSentHeader}">
                        <TileContent>
                            <NumericContent value="{dashboard>/invoicesSent}" valueColor="Good" withMargin="false" />
                        </TileContent>
                    </GenericTile>
                </HBox>
            </Panel>

            <HBox renderType="Bare" class="ohChartGrid">
                <Panel headerText="{i18n>revenueByCountryHeader}" class="ohCard">
                    <viz:VizFrame id="revenueByCountryChart" uiConfig="{applicationSet:'fiori'}" height="300px" width="100%" vizType="bar">
                        <viz:dataset>
                            <vizData:FlattenedDataset data="{dashboard>/revenueByCountry}">
                                <vizData:dimensions>
                                    <vizData:DimensionDefinition name="Country" value="{dashboard>country}" />
                                </vizData:dimensions>
                                <vizData:measures>
                                    <vizData:MeasureDefinition name="Revenue" value="{dashboard>revenue}" />
                                </vizData:measures>
                            </vizData:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Revenue" />
                            <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Country" />
                        </viz:feeds>
                    </viz:VizFrame>
                </Panel>

                <Panel headerText="{i18n>revenueByCategoryHeader}" class="ohCard">
                    <viz:VizFrame id="revenueByCategoryChart" uiConfig="{applicationSet:'fiori'}" height="300px" width="100%" vizType="donut">
                        <viz:dataset>
                            <vizData:FlattenedDataset data="{dashboard>/revenueByCategory}">
                                <vizData:dimensions>
                                    <vizData:DimensionDefinition name="Category" value="{dashboard>category}" />
                                </vizData:dimensions>
                                <vizData:measures>
                                    <vizData:MeasureDefinition name="Revenue" value="{dashboard>revenue}" />
                                </vizData:measures>
                            </vizData:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <vizFeeds:FeedItem uid="size" type="Measure" values="Revenue" />
                            <vizFeeds:FeedItem uid="color" type="Dimension" values="Category" />
                        </viz:feeds>
                    </viz:VizFrame>
                </Panel>
            </HBox>

            <Panel headerText="{i18n>topCustomersHeader}" class="ohCard">
                <Table items="{dashboard>/topCustomers}">
                    <columns>
                        <Column><Text text="{i18n>colCustomer}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colCountry}" /></Column>
                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colOrders}" /></Column>
                        <Column hAlign="End"><Text text="{i18n>colRevenue}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onTopCustomerPress">
                            <cells>
                                <Text text="{dashboard>customerName}" />
                                <Text text="{dashboard>country}" />
                                <Text text="{dashboard>orderCount}" />
                                <ObjectNumber number="{path: 'dashboard>revenue', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}" unit="USD" />
                            </cells>
                        </ColumnListItem>
                    </items>
                    <noData>
                        <Text text="{i18n>noOrders}" />
                    </noData>
                </Table>
            </Panel>

            <Panel headerText="{i18n>recentOrdersHeader}" class="ohCard">
                <Table items="{
                    path: '/SalesOrders',
                    parameters: {
                        $orderby: 'createdAt desc'
                    }
                }" growing="true" growingThreshold="10">
                    <columns>
                        <Column><Text text="{i18n>orderNo}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>customer}" /></Column>
                        <Column><Text text="{i18n>status}" /></Column>
                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>grossAmount}" /></Column>
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>createdAt}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onOrderPress">
                            <cells>
                                <Text text="{orderNo}" />
                                <Text text="{customerName}" />
                                <ObjectStatus text="{status}" state="{
                                    path: 'status',
                                    formatter: '.formatter.statusState'
                                }" />
                                <ObjectNumber number="{grossAmount}" unit="{currency_code}" />
                                <Text text="{path: 'createdAt', formatOptions: {style: 'medium'}}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
