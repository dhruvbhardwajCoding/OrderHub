<mvc:View
    controllerName="orderhub.controller.SalesOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>salesOrdersTitle}" showNavButton="false" class="ohPage">
        <subHeader>
            <Toolbar>
                <SearchField id="ordersSearch" placeholder="{i18n>searchOrders}" search=".onSearch" />
            </Toolbar>
        </subHeader>
        <content>
            <Panel class="ohCard">
                <Table id="ordersTable"
                    mode="SingleSelectMaster"
                    selectionChange=".onOrderSelect"
                    growing="true"
                    growingThreshold="25"
                    items="{
                        path: '/SalesOrders',
                        parameters: {
                            $filter: 'IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null'
                        },
                        sorter: {
                            path: 'createdAt',
                            descending: true
                        }
                    }">
                    <noData>
                        <IllustratedMessage />
                    </noData>
                    <columns>
                        <Column>
                            <Text text="{i18n>orderNo}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>customer}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>status}" />
                        </Column>
                        <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                            <Text text="{i18n>netAmount}" />
                        </Column>
                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>grossAmount}" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="{i18n>createdAt}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation">
                            <cells>
                                <Text text="{= ${orderNo} ? ${orderNo} : ${i18n>draftStatus} }" />
                                <Text text="{customerName}" />
                                <ObjectStatus
                                    text="{parts: [{path: 'IsActiveEntity', targetType: 'any'}, {path: 'status', targetType: 'any'}, {path: 'i18n>draftStatus', targetType: 'any'}], formatter: '.formatter.orderListStatusText'}"
                                    state="{parts: [{path: 'IsActiveEntity', targetType: 'any'}, {path: 'status', targetType: 'any'}], formatter: '.formatter.orderListStatusState'}" />
                                <ObjectNumber number="{netAmount}" unit="{currency_code}" />
                                <ObjectNumber number="{grossAmount}" unit="{currency_code}" />
                                <Text text="{path: 'createdAt', formatOptions: {style: 'medium'}}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
