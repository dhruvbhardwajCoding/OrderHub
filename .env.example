# ──────────────────────────────────────────────
# Northwind Order Hub — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust as needed.
# Values shown are the built-in defaults.

# Northwind OData V4 service URL
# (already configured in package.json – override here if needed)
# cds_requires_northwind_metadata_credentials_url=https://services.odata.org/V4/Northwind/Northwind.svc/

# Tax rate applied to order net amount (decimal, e.g. 0.10 = 10%)
# TAX_RATE=0.10

# Gross amount threshold above which orders require manager approval
# APPROVAL_THRESHOLD=5000
