# ──────────────────────────────────────────────
# Northwind Order Hub — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust as needed.
# Values shown are the built-in defaults.

# Northwind OData V4 service URL
# (already configured in package.json – override here if needed)
# cds_requires_northwind_metadata_credentials_url=https://services.odata.org/V4/Northwind/Northwind.svc/

# Tax rate applied to order net amount (decimal, e.g. 0.10 = 10%)
# TAX_RATE=0.10

# Gross amount threshold above which orders require manager approval
# APPROVAL_THRESHOLD=5000

# How long to wait for a Northwind call before giving up (MD-04). A slow or
# hung Northwind request fails with a readable 504 instead of hanging.
# NORTHWIND_TIMEOUT_MS=8000

# How long to cache Northwind master-data reads (Customers, Products,
# Categories, Suppliers, Shippers) in memory before re-fetching (MD-05,
# Should). Set to 0 to disable caching entirely. Order creation's own
# Northwind lookups (stock, price, discontinued checks) always bypass this
# cache, since they must stay fresh for validation to mean anything.
# NORTHWIND_CACHE_TTL_MS=30000

# ──────────────────────────────────────────────
# Invoice storage (DMS-01..DMS-06)
# ──────────────────────────────────────────────
# Default is "local": invoice PDFs are stored in SQLite (Invoices.content).
# Run with the "hybrid" CDS profile to switch to "sdm" (SAP Document
# Management Service, Integration Option) instead:
#   cds watch --profile hybrid
#
# The service key for a Document Management, Integration Option instance
# (from `cds bind`, or pasted here for local/manual testing) looks like:
# cds_requires_sdm_credentials_url=https://<tenant>.ecmdms.<region>.hana.ondemand.com
# cds_requires_sdm_credentials_repositoryId=<repository id>
# cds_requires_sdm_credentials_uaa_url=https://<tenant>.authentication.<region>.hana.ondemand.com
# cds_requires_sdm_credentials_uaa_clientid=<client id>
# cds_requires_sdm_credentials_uaa_clientsecret=<client secret>
#
# Without these, "sdm" mode fails cleanly (DMS-05): createInvoice is
# rejected and the order is not marked Invoiced, so the clerk can retry.

# ──────────────────────────────────────────────
# Customer map (MAP-01..MAP-04)
# ──────────────────────────────────────────────
# Geocoding uses OpenStreetMap's free Nominatim API, which requires a
# descriptive User-Agent identifying the application (not a browser UA).
# GEOCODE_USER_AGENT=northwind-order-hub (contact@example.com)

# Revenue-band thresholds used to colour customers on the map (gross revenue
# from confirmed orders, in the order's currency).
# REVENUE_BAND_HIGH_THRESHOLD=5000
# REVENUE_BAND_MEDIUM_THRESHOLD=1000

# ──────────────────────────────────────────────
# AI assistant (AI-01, AI-02) — "order from text"
# ──────────────────────────────────────────────
# Without a key, the app runs fully — the AI assistant button is disabled
# with a tooltip explaining why (AI-02). No other feature depends on this.
#
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to call. gemini-3.1-flash-lite is fast and reliable for this
# task; Google's newer gemini-3.8-flash was consistently timing out when
# this was last checked (likely free-tier load on their newest model) even
# though it's the one their own API recommends — if you hit the same thing,
# try a different model from https://ai.google.dev/gemini-api/docs/models.
# GEMINI_MODEL=gemini-3.1-flash-lite

# How long to wait for Gemini before giving up and surfacing a clean error.
# AI_TIMEOUT_MS=15000
