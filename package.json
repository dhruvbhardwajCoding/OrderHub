{
  "name": "northwind-order-hub",
  "version": "1.0.0",
  "description": "SAP CAP backend for Northwind Order Hub — NextMachine AI Labs assessment",
  "repository": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/sqlite": "^1",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^8.9.10",
    "better-sqlite3": "^13.0.3",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8.9.19",
    "axios": "^1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-subset": "^1.6.0",
    "jest": "^29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "cds": {
    "requires": {
      "northwind_metadata": {
        "kind": "odata",
        "model": "srv/external/northwind-metadata",
        "credentials": {
          "url": "https://services.odata.org/V4/Northwind/Northwind.svc/"
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        },
        "[test]": {
          "kind": "sqlite",
          "credentials": {
            "database": ":memory:"
          }
        }
      },
      "auth": {
        "kind": "dummy",
        "mocked": false,
        "users": {
          "alice": {
            "password": "alice",
            "roles": [
              "SalesRep"
            ]
          },
          "bob": {
            "password": "bob",
            "roles": [
              "SalesManager"
            ]
          },
          "carol": {
            "password": "carol",
            "roles": [
              "BillingClerk"
            ]
          }
        }
      },
      "[test]": {
        "auth": {
          "kind": "dummy",
          "mocked": false,
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "SalesRep"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "SalesManager"
              ]
            },
            "carol": {
              "password": "carol",
              "roles": [
                "BillingClerk"
              ]
            }
          }
        }
      }
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
