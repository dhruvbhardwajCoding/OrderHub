{
  "name": "northwind-order-hub",
  "version": "1.0.0",
  "description": "SAP CAP backend for Northwind Order Hub — NextMachine AI Labs assessment",
  "repository": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1.9.2",
    "@cap-js/sqlite": "^1",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^8.9.10",
    "better-sqlite3": "^13.0.3",
    "express": "^4",
    "nodemailer": "^10.0.16",
    "pdfmake": "^0.3.11"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8.9.19",
    "axios": "^1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-subset": "^1.6.0",
    "eslint": "^10.12.0",
    "jest": "^29",
    "nodemailer-mock": "^2.1.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "demo:hybrid": "NODE_OPTIONS='--require ./test/fixtures/mock-sdm-fetch.js' cds_requires_sdm_credentials_url=https://mock.example.com cds_requires_sdm_credentials_repositoryId=repo-1 cds_requires_sdm_credentials_uaa_url=https://mock.example.com cds_requires_sdm_credentials_uaa_clientid=mock cds_requires_sdm_credentials_uaa_clientsecret=mock cds watch --profile hybrid"
  },
  "cds": {
    "requires": {
      "northwind_metadata": {
        "kind": "odata",
        "model": "srv/external/northwind-metadata",
        "credentials": {
          "url": "https://services.odata.org/V4/Northwind/Northwind.svc/"
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        },
        "[test]": {
          "kind": "sqlite",
          "credentials": {
            "database": ":memory:"
          }
        },
        "[hana]": {
          "kind": "hana"
        }
      },
      "invoiceStore": {
        "kind": "local",
        "[hybrid]": {
          "kind": "sdm"
        }
      },
      "sdm": {
        "credentials": {
          "url": "",
          "repositoryId": "",
          "uaa": {
            "url": "",
            "clientid": "",
            "clientsecret": ""
          }
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "password": "alice",
            "roles": [
              "SalesRep"
            ]
          },
          "bob": {
            "password": "bob",
            "roles": [
              "SalesManager"
            ]
          },
          "carol": {
            "password": "carol",
            "roles": [
              "BillingClerk"
            ]
          }
        }
      },
      "[test]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "SalesRep"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "SalesManager"
              ]
            },
            "carol": {
              "password": "carol",
              "roles": [
                "BillingClerk"
              ]
            }
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
