<mvc:View
    controllerName="orderhub.controller.CreateOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="{i18n>createOrderTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <Panel headerText="{i18n>selectedCustomer}">
            <ObjectHeader
                id="customerHeader"
                title="{orderModel>/customerName}">
                <attributes>
                    <ObjectAttribute text="{orderModel>/city}" />
                    <ObjectAttribute text="{orderModel>/country}" />
                </attributes>
            </ObjectHeader>
        </Panel>

        <Panel id="orderItemsPanel" headerText="{i18n>orderItems}">
            <headerToolbar>
                <Toolbar>
                    <Title text="{i18n>orderItems}" />
                    <ToolbarSpacer />
                    <Button icon="sap-icon://add" text="{i18n>addProduct}" press=".onAddProduct" />
                </Toolbar>
            </headerToolbar>
            <Table id="itemsTable" items="{orderModel>/items}">
                <noData>
                    <IllustratedMessage />
                </noData>
                <columns>
                    <Column>
                        <Text text="{i18n>product}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>unitPrice}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>quantity}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>discount}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>remove}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{orderModel>productName}" />
                            <ObjectNumber number="{orderModel>unitPrice}" />
                            <Input value="{orderModel>quantity}" type="Number" placeholder="Qty" />
                            <Input value="{orderModel>discount}" type="Number" placeholder="%" />
                            <Button icon="sap-icon://delete" type="Reject" press=".onRemoveProduct" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <footer>
            <Bar>
                <contentRight>
                    <Button text="{i18n>saveOrder}" press=".onSaveOrder" />
                    <Button text="{i18n>submitOrder}" type="Emphasized" press=".onSubmitOrder" />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
