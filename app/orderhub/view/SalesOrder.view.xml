<mvc:View
    controllerName="orderhub.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page title="{orderNo}" showNavButton="true" navButtonPress=".onNavBack">
        <ObjectHeader
            title="{orderNo}"
            number="{grossAmount}"
            numberUnit="{currency_code}">
            <attributes>
                <ObjectAttribute text="{customerName}" />
                <ObjectAttribute text="{status}" />
            </attributes>
            <statuses>
                <ObjectStatus text="{status}" state="{
                    path: 'status',
                    formatter: '.formatter.statusState'
                }" />
            </statuses>
        </ObjectHeader>
        
        <Panel headerText="{i18n>orderDetails}">
            <f:SimpleForm>
                <f:content>
                    <Label text="{i18n>orderNo}" />
                    <Text text="{orderNo}" />
                    <Label text="{i18n>customerID}" />
                    <Text text="{customerID}" />
                    <Label text="{i18n>customerName}" />
                    <Text text="{customerName}" />
                    <Label text="{i18n>status}" />
                    <Text text="{status}" />
                    <Label text="{i18n>currencyCode}" />
                    <Text text="{currency_code}" />
                    <Label text="{i18n>netAmount}" />
                    <Text text="{netAmount}" />
                    <Label text="{i18n>taxAmount}" />
                    <Text text="{taxAmount}" />
                    <Label text="{i18n>grossAmount}" />
                    <Text text="{grossAmount}" />
                    <Label text="{i18n>createdAt}" />
                    <Text text="{
                        path: 'createdAt',
                        type: 'sap.ui.model.odata.type.DateTimeOffset',
                        formatOptions: { style: 'medium' }
                    }" />
                </f:content>
            </f:SimpleForm>
        </Panel>

        <Panel headerText="{i18n>orderItems}">
            <Table items="{items}">
                <columns>
                    <Column>
                        <Text text="{i18n>product}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>unitPrice}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>quantity}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>discount}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>netAmount}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{productName}" />
                            <ObjectNumber number="{unitPrice}" />
                            <Text text="{quantity}" />
                            <Text text="{discount}" />
                            <ObjectNumber number="{netAmount}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

        <Panel headerText="{i18n>invoiceDetails}" id="invoicePanel" visible="false">
            <f:SimpleForm>
                <f:content>
                    <Label text="{i18n>invoiceNo}" />
                    <Text text="{invoice/invoiceNo}" />
                    <Label text="{i18n>mailStatus}" />
                    <ObjectStatus text="{invoice/mailStatus}" state="{
                        path: 'invoice/mailStatus',
                        formatter: '.formatter.mailStatusState'
                    }" />
                    <Label text="{i18n>sentAt}" />
                    <Text text="{
                        path: 'invoice/sentAt',
                        type: 'sap.ui.model.odata.type.DateTimeOffset',
                        formatOptions: { style: 'medium' }
                    }" />
                    <Label text="{i18n>sentTo}" />
                    <Text text="{invoice/sentTo}" />
                </f:content>
            </f:SimpleForm>
        </Panel>

        <footer>
            <Bar>
                <contentRight>
                    <Button id="btnSubmit" text="{i18n>submit}" type="Emphasized" visible="false" press=".onSubmit" />
                    <Button id="btnApprove" text="{i18n>approve}" type="Accept" visible="false" press=".onApprove" />
                    <Button id="btnCancel" text="{i18n>cancel}" type="Reject" visible="false" press=".onCancel" />
                    <Button id="btnCreateInvoice" text="{i18n>createInvoice}" type="Accept" visible="false" press=".onCreateInvoice" />
                    <Button id="btnViewInvoice" text="{i18n>viewInvoice}" type="Default" visible="false" press=".onViewInvoice" />
                    <Button id="btnSendInvoice" text="{i18n>sendInvoice}" type="Emphasized" visible="false" press=".onSendInvoice" />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
